# EAIMS Application Portal environment configuration
# Copy this file to .env and adjust values as needed.

PORT=3000
NODE_ENV=development
DEV_OTP_DELIVERY=false

# Database
DB_PATH=./data/eaims.db

# Session
SESSION_SECRET=change-this-to-a-long-random-secret-in-production
SESSION_MAX_AGE=86400000

# OTP / verification
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (configure SMTP credentials for real delivery; leave SMTP_HOST empty to use dev console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EAIMS Portal <noreply@eaims.ac.ug>

# Phone (configure SMS provider for real delivery; leave SMS_API_URL empty for dev mock logging)
# SMS_PROVIDER: 'default' (Bearer + JSON) or 'africasTalking' (Basic auth + form data)
SMS_PROVIDER=africasTalking
SMS_API_KEY=
SMS_API_URL=https://api.sandbox.africasTalking.com/version1/messaging
SMS_USERNAME=sandbox
SMS_FROM=EAIMS
SMS_TIMEOUT_MS=10000

# Base URL used in verification links
APP_BASE_URL=http://localhost:3000
