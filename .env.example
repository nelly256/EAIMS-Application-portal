# EAIMS Application Portal environment configuration
# Copy this file to .env and adjust values as needed.

PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/eaims.db
DB_BACKUP_DIR=./data/backups

# Session
# Replace this placeholder with a unique random value of at least 32 characters in production.
SESSION_SECRET=change-this-to-a-long-random-secret-in-production
SESSION_MAX_AGE=86400000

# OTP / verification
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Chatbot (AI is optional; set a current Groq model and key to enable generated answers)
GROQ_API_KEY=
GROQ_MODEL=
CHATBOT_TIMEOUT_MS=15000
CHATBOT_MAX_MESSAGES_PER_HOUR=30

# Email (configure SMTP credentials for real delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EAIMS Portal <noreply@eaims.ac.ug>

# Phone (configure SMS provider for real delivery; leave SMS_API_URL empty to disable SMS)
# SMS_PROVIDER: 'default' (Bearer + JSON) or 'africasTalking' (Basic auth + form data)
SMS_PROVIDER=africasTalking
SMS_API_KEY=
SMS_API_URL=https://api.sandbox.africasTalking.com/version1/messaging
SMS_USERNAME=sandbox
SMS_FROM=EAIMS
SMS_TIMEOUT_MS=10000

# Base URL used for verification and password reset links.
# In production, set this to the site's public HTTPS URL.
APP_BASE_URL=http://localhost:3000

# ACMIS integration (leave both values empty to disable synchronization).
# Use the ACMIS API base URL without a trailing slash and the shared Portal integration token.
# The token must match PORTAL_INTEGRATION_TOKEN in the ACMIS deployment.
ACMIS_API_BASE_URL=
ACMIS_PORTAL_TOKEN=
ACMIS_REQUEST_TIMEOUT_MS=10000
ACMIS_SYNC_INTERVAL_MS=30000
