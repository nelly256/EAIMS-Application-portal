{
  "name": "eaims-application-portal",
  "version": "1.0.0",
  "description": "East African Institute for Management Science - Online Application Portal",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/db.js migrate",
    "admin:create": "node scripts/create-admin.js",
    "db:backup": "node scripts/backup-database.js",
    "db:verify-backup": "node scripts/verify-database-backup.js",
    "support-agent:create": "node scripts/create-support-agent.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "9.1.1",
    "sqlite3": "^6.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
